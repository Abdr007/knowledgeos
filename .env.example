# KnowledgeOS AI — configuration template (§21)
#
# Copy to .env and fill in. Every variable the system reads is listed here; the
# application reads os.environ in exactly one place (app/core/config.py), so this
# file is the complete surface.
#
# NEVER put real values in this file — it is committed. Secrets belong in .env
# locally and in a secret manager in staging/production (§28.1).

# ── application ──────────────────────────────────────────────────────
ENVIRONMENT=local                       # local | staging | production | test
DEBUG=false
CORS_ORIGINS=http://localhost:3000      # comma-separated. Never "*" (§18)

# ── security ─────────────────────────────────────────────────────────
# Required, minimum 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14

# ── datastores ───────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://knowledgeos:knowledgeos@localhost:5432/knowledgeos
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledgeos_chunks

# ── LLM (D1) ─────────────────────────────────────────────────────────
# anthropic | openai | scripted
#   scripted = deterministic offline provider used by tests and by the demo
#   before a live key is available. Switching to a real provider is this one line.
LLM_PROVIDER=scripted
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CHAT_MODEL=claude-opus-5
UTILITY_MODEL=claude-haiku-4-5          # titles, query rewriting — cheap on purpose
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3

# ── embeddings (D2) ──────────────────────────────────────────────────
# Local ONNX inference: no API key, no per-token cost, no document text leaving
# the deployment. Anthropic ships no embeddings API, so this is not optional
# when LLM_PROVIDER=anthropic.
EMBEDDING_PROVIDER=local                # local | openai
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384                # must match the model (§29.3)

# ── ingestion & retrieval ────────────────────────────────────────────
MAX_UPLOAD_BYTES=52428800               # 50 MB
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=150
EMBEDDING_BATCH_SIZE=64
RETRIEVAL_CANDIDATES=40                 # breadth before fusion
RETRIEVAL_TOP_K=8                       # after fusion + diversity
RELEVANCE_FLOOR=0.58                    # cosine; below this the refusal gate fires (§10)

# ── storage ──────────────────────────────────────────────────────────
STORAGE_BACKEND=local                   # local | s3
STORAGE_LOCAL_PATH=./storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=

# ── limits & observability ───────────────────────────────────────────
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=10
LOG_LEVEL=INFO
LOG_JSON=true
